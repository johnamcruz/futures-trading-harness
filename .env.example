# Copy to ~/.futures-trading-harness/.env (preferred: outside the repo) or to
# .env in the repo root (git-ignored), then `chmod 600` it. The autotrader,
# backtest fetch, orderflow recorder, and MCP gateway read it at start; a
# variable already set in the environment wins. Never commit the real file.

# TopstepX / ProjectX API (used by the runner and by projectx-mcp)
PROJECTX_USERNAME=your-topstepx-username
PROJECTX_API_KEY=your-api-key

# projectx-mcp guardrails (see mcp-configs/projectx.example.json)
# PROJECTX_TRADING_ENABLED=false
# PROJECTX_ALLOWED_ACCOUNT_IDS=123456
# PROJECTX_MAX_DAILY_LOSS=500

# Harness settings (optional)
# FTH_HOME=~/.futures-trading-harness
