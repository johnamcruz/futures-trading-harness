# Copy to ~/.futures-trading-harness/.env (preferred: outside the repo) or to
# .env in the repo root (git-ignored), then `chmod 600` it. The MCP gateway,
# the autotrader, and the bar/backtest CLIs read it at start and pass it to the
# broker MCP server; a variable already set in the environment wins. Never
# commit the real file.

# Broker MCP server (mcp-configs/brokers.json). Default: topstepx (projectx-mcp).
# FTH_BROKER=topstepx
PROJECTX_MCP_ENTRY=/absolute/path/to/projectx-mcp/dist/index.js

# projectx-mcp settings: credentials and its guardrails
PROJECTX_USERNAME=your-topstepx-username
PROJECTX_API_KEY=your-api-key
# PROJECTX_TRADING_ENABLED=false
# PROJECTX_ALLOWED_ACCOUNT_IDS=123456
# PROJECTX_ALLOWED_SYMBOLS=MNQ,MES
# PROJECTX_MAX_ORDER_SIZE=1
# PROJECTX_MAX_POSITION_SIZE=1
# PROJECTX_MAX_DAILY_LOSS=500

# Harness settings (optional)
# FTH_HOME=~/.futures-trading-harness
