{
  "name": "futures-trading-harness",
  "version": "0.2.0",
  "private": true,
  "description": "LLM-agnostic futures trading harness (Claude Code, Codex, Qwen Code) through any broker MCP server: strategies as Markdown, parallel agent roles, an enforced order gate, and an autonomous runner.",
  "license": "MIT",
  "author": "John Cruz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnamcruz/futures-trading-harness.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node tests/run-all.js",
    "lint": "eslint . && markdownlint-cli2",
    "sync": "node scripts/sync-harness.js",
    "sync:check": "node scripts/sync-harness.js --check",
    "strategies": "node scripts/strategies.js",
    "snapshot": "node scripts/market-snapshot.js",
    "autotrader": "node scripts/autotrader.js",
    "gateway": "node scripts/mcp-gateway.js",
    "install-harness": "node scripts/install.js",
    "check:secrets": "node scripts/check-secrets.js",
    "hooks:install": "node scripts/check-secrets.js --install-hook"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "markdownlint-cli2": "^0.23.3"
  }
}
