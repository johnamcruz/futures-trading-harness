{
  "env": {
    "FTH_HOOK_PROFILE": "standard",
    "FTH_PLAN_MAX_AGE_MIN": "120",
    "FTH_MAX_CONSECUTIVE_LOSSES": "2",
    "FTH_LOSS_COOLDOWN_MIN": "30",
    "FTH_MAX_DAILY_LOSSES": "3",
    "FTH_MAX_ENTRIES_PER_DAY": "6",
    "FTH_NO_ENTRY_WINDOWS": "09:30-09:35@America/New_York,15:45-16:00@America/New_York"
  },
  "permissions": {
    "ask": [
      "mcp__broker__place_order",
      "mcp__broker__modify_order",
      "mcp__broker__cancel_order",
      "mcp__broker__close_position",
      "mcp__broker__partial_close_position"
    ],
    "allow": [
      "mcp__broker__get_server_config",
      "mcp__broker__list_accounts",
      "mcp__broker__get_account_snapshot",
      "mcp__broker__search_contracts",
      "mcp__broker__get_contract",
      "mcp__broker__list_available_contracts",
      "mcp__broker__get_bars",
      "mcp__broker__get_quote",
      "mcp__broker__list_open_orders",
      "mcp__broker__search_orders",
      "mcp__broker__list_open_positions",
      "mcp__broker__search_trades",
      "mcp__broker__get_performance",
      "mcp__broker__journal_read",
      "mcp__broker__journal_add"
    ]
  }
}
