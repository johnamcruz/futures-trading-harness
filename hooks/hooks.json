{
  "description": "Futures trading harness hooks: deterministic order discipline for projectx-mcp (TopstepX).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*projectx.*__(place_order|modify_order)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/run-with-flags.js\" pre:trading:order-gate scripts/hooks/trading-order-gate.js minimal,standard,strict",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/run-with-flags.js\" session-start:trading:briefing scripts/hooks/trading-session-start.js minimal,standard,strict",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/run-with-flags.js\" stop:trading:review-reminder scripts/hooks/trading-stop-review.js standard,strict",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
